# ============================================================
# Scribe environment variables — copy to .env and fill in.
# Phase markers indicate when each var becomes required.
# ============================================================

# ----- Phase 0 (foundation) -----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ----- Runtime environment + feature flags -----
# Both server (Rust) and client (Vite) read these. See
# `scribe.config.toml.example` for the structured form.
# SCRIBE_ENV: development | production | testing  (default: development)
SCRIBE_ENV=development
# Optional TOML config file path. When set, the server loads it on top
# of per-env defaults; env vars then override individual fields.
# SCRIBE_CONFIG_FILE=./scribe.config.toml
#
# Per-flag overrides — set to true/false to flip. Useful when you want
# a single switch without touching the TOML file.
# SCRIBE_FEATURE_CACHE_ENABLED=false
# SCRIBE_FEATURE_CLIENT_CACHE_HEADERS=false
# SCRIBE_FEATURE_YJS_REALTIME=true
# SCRIBE_FEATURE_COMPILE_WORKER=true
# SCRIBE_FEATURE_RATE_LIMITING=false
# SCRIBE_FEATURE_METRICS_ENDPOINT=true
# SCRIBE_FEATURE_DEBUG_LOGGING=true
#
# Client (Vite) — exposed to the browser. Same conventions, prefixed
# `VITE_FEATURE_<NAME>`. A runtime override is also available via
# `localStorage.SCRIBE_FEATURE_<NAME>` so you can flip a flag from
# DevTools without restarting Vite.
# VITE_SCRIBE_ENV=development
# VITE_FEATURE_API_CACHING=false
# VITE_FEATURE_QUERY_REVALIDATION=true
# VITE_FEATURE_YJS_REALTIME=true
# VITE_FEATURE_DEBUG_LOGGING=true
# VITE_FEATURE_DEV_GLOBALS=true

# ----- Phase 1 (auth, projects, files) -----
# Supabase — get these from `supabase status` (local) or your project dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Web app needs these (Vite exposes vars prefixed VITE_*).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000

# Public URL the web app is reachable at (used in invite emails, OAuth callbacks).
# APP_URL=http://localhost:5173

# Email (Nodemailer; Resend etc. work via SMTP relay).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Scribe <no-reply@scribe.local>"

# File-size caps. Bytes. Configurable per deployment.
# FILE_SIZE_MAX_BYTES=52428800     # 50 MiB per file
# PROJECT_SIZE_MAX_BYTES=104857600 # 100 MiB per project

# ----- Phase 2 (compile pipeline) -----
REDIS_URL=redis://127.0.0.1:6379
COMPILE_QUEUE_NAME=scribe-compile
COMPILE_TIMEOUT_MS=120000
COMPILE_JOBS_CONCURRENT_PER_USER=5
MAX_COMPILE_ARTIFACTS_PER_PROJECT=10
# Compile pipeline. "tectonic" (default) = single binary, auto-fetched
# CTAN packages, ~4s per warm compile. "latexmk" = Overleaf-style
# (latexmk → pdflatex/xelatex/lualatex against local TeX Live / MiKTeX),
# ~1.2s per warm compile but requires the distribution to be installed
# on the host.
# COMPILE_ENGINE=latexmk
TECTONIC_BIN=tectonic
# LATEXMK_BIN=latexmk
# LATEX_ENGINE=pdflatex   # one of: pdflatex (default) | xelatex | lualatex

# Storage bucket names (provisioned by Supabase migration).
# STORAGE_BUCKET_FILES=project-files
# STORAGE_BUCKET_PDFS=compile-artifacts
# STORAGE_BUCKET_VERSIONS=version-snapshots
# STORAGE_BUCKET_TEMPLATES=template-thumbnails

# ----- Phase 3 (realtime collaboration) -----
# YJS_DOC_DEBOUNCE_MS=5000
# YJS_COMPACTION_INTERVAL_HOURS=1
# YJS_WS_PATH=/yjs

# ----- Phase 4 (AI) -----
# 32-byte random key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for any AI feature. NEVER commit this value.
# AI_KEY_ENCRYPTION_KEY=

# Rate limits.
# AI_REQUESTS_PER_MINUTE=20
# COMPILE_JOBS_CONCURRENT_PER_USER=5

# ----- Optional observability -----
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

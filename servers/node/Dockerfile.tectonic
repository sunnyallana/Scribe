# Compile worker image. Runs the BullMQ worker that pulls files from
# Supabase Storage and invokes tectonic. Production: deploy alongside
# the main Fastify server image; both pull from the same Redis.

FROM node:20-bookworm-slim AS deps
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate

WORKDIR /workspace
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY server/package.json ./server/
COPY packages ./packages
COPY tsconfig.base.json ./

# Install only production dependencies for the workspace.
RUN pnpm install --frozen-lockfile --filter @scribe/server... --filter @scribe/compiler-client --filter @scribe/shared

# ----- builder stage -----
FROM deps AS builder
COPY server ./server
RUN pnpm --filter @scribe/shared build \
 && pnpm --filter @scribe/compiler-client build \
 && pnpm --filter @scribe/server build

# ----- runtime stage with tectonic binary -----
FROM debian:bookworm-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl ca-certificates xz-utils libfontconfig1 libgraphite2-3 libharfbuzz0b \
      libicu72 libssl3 libstdc++6 zlib1g \
 && rm -rf /var/lib/apt/lists/*

# Install Node.js runtime (20.x).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Install tectonic from upstream release.
ARG TECTONIC_VERSION=0.15.0
RUN curl -fsSL \
    "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic@${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin tectonic \
 && chmod +x /usr/local/bin/tectonic

# Pre-warm the tectonic resource cache so first compile in a container
# doesn't have to fetch ~hundreds of MB of TeX Live bundles on the user's
# critical path.
RUN tectonic --help >/dev/null 2>&1 || true

WORKDIR /app
COPY --from=builder /workspace/server/dist ./server/dist
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/server/package.json ./server/

ENV NODE_ENV=production
USER node
CMD ["node", "server/dist/workers/compile.js"]

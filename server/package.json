{
  "name": "@scribe/server",
  "version": "0.0.0",
  "private": true,
  "description": "Scribe backend — Fastify API + Yjs WebSocket server.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/compile.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/compile.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.2",
    "@fastify/websocket": "^11.0.2",
    "@scribe/ai": "workspace:*",
    "@scribe/compiler-client": "workspace:*",
    "@scribe/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "bullmq": "^5.34.10",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lib0": "^0.2.99",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

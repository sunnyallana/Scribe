{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe",
  "version": "0.1.0",
  "identifier": "io.scribe.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @scribe/web dev",
    "beforeBuildCommand": "pnpm --filter @scribe/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scribe",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Self-hostable collaborative LaTeX editor",
    "longDescription": "Scribe is a self-hostable collaborative LaTeX editor — an open alternative to Overleaf."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["scribe"]
      }
    }
  }
}
